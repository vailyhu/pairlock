 "rules": [
  {
   "on": "cistern_reach",
   "if": {
    "not": {
     "solved": "A szalag üzenete"
    }
   },
   "do": {
    "say": "A víz jéghideg. Ameddig a karod ér, csak síkos követ tapintasz. A ciszterna mély és sötét, így vakon, találomra ennél többet nem tudsz átnézni."
   }
  },
  {
   "on": "cistern_reach",
   "if": {
    "var": "cistern_rope",
    "is": "up"
   },
   "do": {
    "say": "A ciszterna fedele nyitva. A kötél üresen lóg a perem alatti kampóról, a víz alatta fekete."
   }
  },
  {
   "on": "cistern_reach",
   "if": {
    "all": [
     {
      "solved": "A szalag üzenete"
     },
     {
      "not": {
       "var": "cistern_rope",
       "is": "up"
      }
     }
    ]
   },
   "do": {
    "say": "Most már tudjátok, hogy itt kell keresni. Hason fekve, vállig a vízbe nyúlva, jóval a perem alatt egy kampót tapintotok ki, rajta egy kötél. Felhúzva egy lezárt bádogdoboz jön vele. Benne az égőfej és egy levél.",
    "images": [
     "ciszterna",
     "bedoboz",
     "ante_vege"
    ],
    "give": [
     {
      "id": "i_egofej",
      "name": "Égőfej"
     },
     {
      "id": "ante_vege",
      "name": "Kružić levele"
     }
    ],
    "setVar": {
     "cistern_rope": "up"
    }
   }
  },
  {
   "on": "solved:Égett levél",
   "do": {
    "say": "A papírdarabok összeálltak.",
    "images": [
     "level_egesz"
    ],
    "give": [
     {
      "id": "level_egesz",
      "name": "Égett levél"
     }
    ]
   }
  },
  {
   "on": "solved:V.B. ládája",
   "do": {
    "say": "A ládában egy kis zsebkönyv és egy nehéz vaskulcs van.",
    "images": [
     "fokonyv"
    ],
    "give": [
     {
      "id": "i_fokonyv",
      "name": "Zsebkönyv"
     },
     {
      "id": "i_kulcs",
      "name": "Vaskulcs"
     }
    ]
   }
  },
  {
   "on": "solved:Lépcsőajtó",
   "do": {
    "say": "A retesz enged, mögötte szűk csigalépcső indul felfelé."
   }
  },
  {
   "on": "solved:Szerszámláda",
   "do": {
    "say": "A ládában egy szelepkerék, tartalék fogaskerekek és egy jelkönyv van, két megjelölt oldallal.",
    "images": [
     "jelkonyv",
     "morzetabla"
    ],
    "give": [
     {
      "id": "i_szelep",
      "name": "Szelepkerék"
     },
     {
      "id": "i_kerekek",
      "name": "Tartalék fogaskerekek"
     },
     {
      "id": "i_jelkonyv",
      "name": "Jelkönyv"
     }
    ]
   }
  },
  {
   "on": "solved:Olajvezeték",
   "do": {
    "say": "A vezeték zárt.",
    "emit": "maybe_pressure"
   }
  },
  {
   "on": "maybe_pressure",
   "if": {
    "all": [
     {
      "solved": "Olajvezeték"
     },
     {
      "not": {
       "solved": "Olajnyomás"
      }
     },
     {
      "item": "hatch",
      "state": "open"
     }
    ]
   },
   "do": {
    "say": "A vezeték zárt. Most a nyomást kell beállítani: egyikőtöknek itt, a szelepeknél, a másiknak a Lámpatérben, a mérőknél.",
    "panel": {
     "id": "gauge_board",
     "label": "Olajnyomás"
    }
   }
  },
  {
   "on": "solved:Olajnyomás",
   "do": {
    "say": "A nyomás rendben.",
    "emit": "maybe_ready"
   }
  },
  {
   "on": "solved:A szalag üzenete",
   "do": {
    "say": "A szalag a végére ért. Ciszterna. Talán alaposabban át kellene nézni."
   }
  },
  {
   "on": "maybe_ready",
   "if": {
    "all": [
     {
      "solved": "Olajvezeték"
     },
     {
      "solved": "Olajnyomás"
     },
     {
      "item": "lamp_seat",
      "state": "fitted"
     }
    ]
   },
   "do": {
    "say": "Minden készen áll a gyújtásra: egyikőtök a hajtóműnél, a másik itt, a dobnál.",
    "panel": {
     "id": "shutter_lamp",
     "label": "Lencsedob és gyújtás",
     "if": {
      "all": [
       {
        "solved": "Olajvezeték"
       },
       {
        "solved": "Olajnyomás"
       },
       {
        "item": "lamp_seat",
        "state": "fitted"
       }
      ]
     }
    }
   }
  }
 ],
